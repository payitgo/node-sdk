{
  "name": "@payitgo/node",
  "version": "0.2.1",
  "description": "Node.js library for the payitgo crypto payment gateway",
  "license": "MIT",
  "author": "payitgo (https://payitgo.co)",
  "homepage": "https://payitgo.co",
  "repository": { "type": "git", "url": "git+https://github.com/payitgo/node-sdk.git" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./esm/index.d.mts", "default": "./esm/index.mjs" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "esm"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js test/*.test.mjs",
    "prepare": "npm run build"
  },
  "keywords": ["payitgo", "payments", "crypto", "usdt", "bitcoin"],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
